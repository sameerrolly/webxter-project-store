# ── Copy this file to .env.local for local dev ────────────────────────────────
# Fill in your real values. NEVER commit .env.local — it is gitignored.

# Django backend URL
# Local dev:
VITE_API_URL=http://127.0.0.1:8000
# Production:
# VITE_API_URL=https://api.your-domain.com

# Razorpay key
# Test key (safe for local dev):
VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
# Live key (production only — never commit):
# VITE_RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_LIVE_KEY

# Supabase Storage
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
VITE_SUPABASE_MEDIA_BUCKET=Project-files
