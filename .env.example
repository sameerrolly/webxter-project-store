# ── Copy this file to .env.local for local dev, or .env.production for prod ──

# Django backend URL
# Local dev:
VITE_API_URL=http://127.0.0.1:8000
# Production:
# VITE_API_URL=https://api.your-domain.com

# Razorpay key
# Test key (safe for local dev):
VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
# Live key (production only — never commit):
# VITE_RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_LIVE_KEY
